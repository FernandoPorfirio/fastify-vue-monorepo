# Copy this file to apps/api/.env and apps/migrations/.env

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=appdb

# API (only for apps/api/.env)
PORT=3333
HOST=0.0.0.0

# JWT (only for apps/api/.env)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (only for apps/api/.env)
CORS_ORIGIN=http://localhost:5173
